{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://kadchmaportal.com https://www.kadchmaportal.com https://kadchma-admin.vercel.app"
        }
      ]
    }
  ]
}
